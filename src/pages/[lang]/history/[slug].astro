---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { t } from "../../../lib/i18n";

export async function getStaticPaths() {
  const historyEntries = await getCollection("history");
  return historyEntries.flatMap((entry) => {
    return ["en", "ar"].map((lang) => ({
      params: { lang, slug: entry.slug },
      props: { entry },
    }));
  });
}

const { lang } = Astro.params;
const { entry } = Astro.props;
const { Content } = await entry.render();
const isArabic = lang === "ar";

const title = entry.data.title[lang];
const description = entry.data.summary[lang];

// Simple markdown formatter for content from frontmatter
function formatMarkdown(text: string): string {
  let html = text;

  // Convert ## headers
  html = html.replace(/^## (.+)$/gm, "<h2>$1</h2>");
  // Convert ### headers
  html = html.replace(/^### (.+)$/gm, "<h3>$1</h3>");
  // Convert bold
  html = html.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
  // Convert bullet lists
  html = html.replace(/^- (.+)$/gm, "<li>$1</li>");
  html = html.replace(/(<li>.*?<\/li>)/s, "<ul>$1</ul>");
  // Convert paragraph breaks
  html = html.replace(/\n\n+/g, "</p><p>");
  html = "<p>" + html + "</p>";

  return html;
}
---

<BaseLayout {title} {description} {lang}>
  <!-- Hero Section -->
  <div class="relative bg-atlas-paper border-b border-stone-200" dir={isArabic ? "rtl" : "ltr"}>
    <div class="container mx-auto px-4 py-16 md:py-24 max-w-4xl text-center">
      <div class="mb-6">
        <a
          href={`/${lang}/history`}
          class="inline-flex items-center text-sm font-medium text-atlas-red hover:text-atlas-red-dark transition-colors mb-6"
        >
          <span class={isArabic ? "ml-2 rotate-180" : "mr-2"}>←</span>
          {isArabic ? "العودة إلى التاريخ" : "Back to History"}
        </a>
        <div class="inline-block px-3 py-1 bg-stone-100 rounded-full text-stone-600 text-sm mb-4">
          {entry.data.period[lang]}
        </div>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 font-display leading-tight">
        {title}
      </h1>
      
      <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        {description}
      </p>
    </div>
  </div>

  <!-- Content Section -->
  <div class="container mx-auto px-4 py-12 max-w-3xl" dir={isArabic ? "rtl" : "ltr"}>
    <article class="prose prose-stone prose-lg max-w-none 
      prose-headings:font-display prose-headings:font-bold prose-headings:text-gray-900
      prose-p:text-gray-700 prose-p:leading-relaxed
      prose-a:text-atlas-red prose-a:no-underline hover:prose-a:text-atlas-red-dark
      prose-strong:text-gray-900 prose-strong:font-semibold
      prose-ul:list-disc prose-ul:pl-6
      marker:text-stone-400">
      {
        entry.data.content && entry.data.content[lang] ? (
          <div set:html={formatMarkdown(entry.data.content[lang])} />
        ) : (
          <Content />
        )
      }
    </article>

    {/* Sources Section if available */}
    {entry.data.sources && entry.data.sources.length > 0 && (
      <div class="mt-16 pt-8 border-t border-stone-200">
        <h3 class="text-lg font-bold text-gray-900 mb-4">
          {isArabic ? "المصادر" : "Sources"}
        </h3>
        <ul class="space-y-2">
          {entry.data.sources.map((source) => (
            <li class="text-gray-600 text-sm flex items-start">
              <span class="mr-2 text-atlas-red">•</span>
              {source}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</BaseLayout>
