---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentPageHeader from "../../../components/ContentPageHeader.astro";
import { t } from "../../../lib/translations";

export async function getStaticPaths() {
  const languages = ["en", "ar"];
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const isArabic = lang === "ar";
const historyEntries = await getCollection("history");

// Group by category
const categories = {};
historyEntries.forEach((entry) => {
  const category = entry.data.category || "Other";
  if (!categories[category]) {
    categories[category] = [];
  }
  categories[category].push(entry);
});

// Sort categories and entries
const sortedCategories = Object.keys(categories).sort(); // You might want custom order logic later
sortedCategories.forEach((cat) => {
  categories[cat].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
});
---

<BaseLayout>
  <ContentPageHeader
    title={isArabic ? "تاريخ اليمن" : "History of Yemen"}
    description={isArabic
      ? "استكشف التاريخ الغني لليمن عبر العصور"
      : "Explore the rich history of Yemen through the ages"}
    {lang}
  />

  <div class="container mx-auto px-4 py-12">
    {
      sortedCategories.map((category) => (
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-primary mb-6 border-b border-light-stone pb-2">
            {t(lang as any, `history.categories.${category}`) || category}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {categories[category].map((entry) => (
              <a
                href={`/${lang}/history/${entry.slug}`}
                class="block p-6 bg-aged-paper border border-light-stone rounded-lg hover:shadow-lg transition-transform hover:-translate-y-1"
              >
                <div class="flex justify-between items-start mb-3">
                  <h3 class="text-xl font-bold text-archive-ink">
                    {entry.data.title[lang]}
                  </h3>
                </div>
                <div class="text-sm text-text-dark/70 mb-4 bg-light-stone/20 inline-block px-2 py-1 rounded">
                  {entry.data.period[lang]}
                </div>
                <p class="text-text-dark/80 line-clamp-3">
                  {entry.data.summary[lang]}
                </p>
                <div class="mt-4 text-accent text-sm font-medium flex items-center gap-1 group-hover:gap-2 transition-all">
                  {isArabic ? "اقرأ المزيد" : "Read More"}
                  <span class={isArabic ? "rotate-180" : ""}>→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }

    {
      historyEntries.length === 0 && (
        <div class="text-center py-20 text-gray-500">
          <p class="text-xl">
            {isArabic ? "لا يوجد محتوى حالياً" : "No content available yet"}
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
